  "pages": [
    {
      "id": "welcome",
      "title": "Tell us about your greedyQ experience",
      "body": "This survey is for people who have used greedyQ to create or revise a questionnaire. It takes about four minutes.",
      "questions": [],
      "show_previous": false,
      "next": "consent",
      "next_label": "Read participant information"
    },
    {
      "id": "consent",
      "title": "Participant information and consent",
      "body": "Please read the versioned participant information and consent. Taking part is voluntary, and you may stop at any time.",
      "questions": [
        {
          "id": "consent_choice",
          "type": "mc",
          "label": "Do you consent to participate in this survey?",
          "options": [
            {
              "label": "Yes, I consent",
              "value": "yes"
            },
            {
              "label": "No, I do not consent",
              "value": "no"
            }
          ],
          "required": true
        }
      ],
      "show_previous": false,
      "next": "eligibility",
      "next_label": "Continue",
      "routes": [
        {
          "when": {
            "field": "consent_choice",
            "equals": "no"
          },
          "to": "consent_refused"
        }
      ]
    },
    {
      "id": "eligibility",
      "title": "About your eligibility",
      "body": "",
      "questions": [
        {
          "id": "age",
          "type": "numeric",
          "label": "What is your age in years?",
          "placeholder": "Age",
          "required": true,
          "max": 120,
          "min": 0
        },
        {
          "id": "used_greedyq",
          "type": "mc",
          "label": "Have you used greedyQ to create or revise a questionnaire?",
          "options": [
            {
              "label": "Yes",
              "value": "yes"
            },
            {
              "label": "No",
              "value": "no"
            }
          ],
          "required": true
        }
      ],
      "show_previous": true,
      "next": "usage",
      "routes": [
        {
          "when": {
            "field": "age",
            "lt": 18
          },
          "to": "screened_out"
        },
        {
          "when": {
            "field": "used_greedyq",
            "equals": "no"
          },
          "to": "screened_out"
        }
      ]
    },
