{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greedyq.dev/schemas/guide/guide-lock.schema.json",
  "title": "greedyQ Resolved Guide Lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "greedyq_release", "registry_sha256", "object", "profile", "modules", "resolved_components", "resolved_files"],
  "properties": {
    "schema_version": {"const": "0.2"},
    "greedyq_release": {"type": "string", "minLength": 1},
    "registry_sha256": {"$ref": "#/$defs/hash"},
    "object": {"type": "string", "pattern": "^greedyQ[A-Za-z]+$"},
    "profile": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "modules": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "resolved_components": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "version", "manifest", "manifest_sha256"],
        "properties": {
          "id": {"type": "string"}, "kind": {"enum": ["core", "profile", "module"]},
          "version": {"type": "string"}, "manifest": {"type": "string"}, "manifest_sha256": {"$ref": "#/$defs/hash"}
        }
      }
    },
    "resolved_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "path", "sha256"],
        "properties": {"component": {"type": "string"}, "path": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"}}
      }
    }
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
